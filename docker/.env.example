# Copy to .env (Dokploy Environment tab writes these automatically)

POSTGRES_USER=qbank
POSTGRES_PASSWORD=qbank
POSTGRES_DB=qbank
POSTGRES_PORT=5433

REDIS_PORT=6380

DATABASE_URL=postgresql+asyncpg://qbank:qbank@db:5432/qbank
REDIS_URL=redis://redis:6379/0
SECRET_KEY=dev-secret-key-change-in-production-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://edumate.com.vn"]
DEBUG=true

BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000/api/v1
